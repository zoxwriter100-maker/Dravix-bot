# Keep your token secret. Never share .env or your bot token.
DISCORD_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Optional: your server ID makes slash commands appear faster while testing.
GUILD_ID=0

# Comma-separated staff role IDs. Example: 111111111111111111,222222222222222222
STAFF_ROLE_IDS=

# Optional Discord category ID where ticket channels should be created. 0 = no category.
TICKET_CATEGORY_ID=0

# Required for staff application review buttons to be posted.
APPLICATION_REVIEW_CHANNEL_ID=0

# Required for transcripts to be sent when a ticket closes.
TRANSCRIPT_LOG_CHANNEL_ID=0

PANEL_TITLE=Dravixplayz Bot | pravite:1
